# Managed build versions.
# Precedence: workflow input / environment variable > this file > hard failure.
# Format: KEY=value, no quotes, no inline comments.

SING_BOX_REF=v1.14.4
GO_VERSION=1.27.3

# Arch-style rebuild counter. Reset to 1 when SING_BOX_REF changes.
# Increment for a Go/toolchain-only rebuild of the same sing-box version.
PKGREL=1
